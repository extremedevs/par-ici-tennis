# Mot de passe pour accéder au tableau de bord
APP_PASSWORD=choisis-un-mot-de-passe-long

# Supabase (Project Settings → API). La clé service_role reste côté serveur.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Jeton partagé avec la Lambda (variable TRACKER_TOKEN)
TRACKER_TOKEN=

# --- Admin (gestion des comptes AWS) ---
# Mot de passe admin, différent de APP_PASSWORD
ADMIN_PASSWORD=

# Utilisateur IAM dédié à Vercel (préfixe PIT_ car Vercel réserve AWS_*)
PIT_AWS_REGION=eu-west-3
PIT_AWS_ACCESS_KEY_ID=
PIT_AWS_SECRET_ACCESS_KEY=
LAMBDA_ARN=arn:aws:lambda:eu-west-3:635936555914:function:par-ici-tennis
SCHEDULER_ROLE_ARN=arn:aws:iam::635936555914:role/par-ici-tennis-scheduler-role
